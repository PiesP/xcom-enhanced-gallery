{
  "name": "xcom-enhanced-gallery",
  "version": "2.3.9",
  "private": true,
  "description": "Desktop media gallery and original-quality downloader for X.com.",
  "keywords": [
    "browser-extension",
    "gallery",
    "media",
    "twitter",
    "userscript",
    "x.com"
  ],
  "homepage": "https://github.com/PiesP/xcom-enhanced-gallery#readme",
  "bugs": {
    "url": "https://github.com/PiesP/xcom-enhanced-gallery/issues"
  },
  "license": "MIT",
  "author": "PiesP",
  "repository": {
    "type": "git",
    "url": "https://github.com/PiesP/xcom-enhanced-gallery"
  },
  "type": "module",
  "scripts": {
    "preinstall": "node --experimental-strip-types scripts/check/bootstrap.ts",
    "prebuild": "vp run check:prebuild",
    "build": "vp build",
    "build:extension": "vp run build:extension:steps",
    "build:extension:firefox": "vp run build:extension:firefox:steps",
    "build:all": "vp run build:all:steps",
    "build:dev": "vp build --mode development",
    "build:fast": "vp build",
    "package:extension": "node --experimental-strip-types scripts/release/package-extension.ts",
    "package:all": "vp run package:all:steps",
    "release:prepare": "node --experimental-strip-types scripts/release/prepare.ts",
    "build:ci": "vp build",
    "build:extension:ci": "vp run build:extension:ci:steps",
    "build:extension:firefox:ci": "vp run build:extension:firefox:ci:steps",
    "build:all:ci": "node --experimental-strip-types scripts/release/build-all.ts",
    "build:e2e": "vp run build:e2e:steps",
    "clean": "node --experimental-strip-types scripts/build/clean.ts",
    "check:src": "tsc --noEmit",
    "check:test": "tsc -p tsconfig.test.json --noEmit",
    "check:scripts": "tsc -p tsconfig.scripts.json --noEmit && tsc -p tsconfig.node-tests.json --noEmit && tsc -p tsconfig.windows.json --noEmit",
    "check": "vp run check:steps",
    "check:versions": "node --experimental-strip-types scripts/release/version.ts check",
    "sync:versions": "node --experimental-strip-types scripts/release/version.ts sync",
    "typecheck": "vp run check",
    "lint": "vp lint . --deny-warnings",
    "lint:fix": "vp lint . --fix --deny-warnings",
    "fmt": "vp fmt --check",
    "fmt:fix": "vp fmt --write",
    "fmt:check": "vp run fmt",
    "quality": "vp run quality:steps",
    "quality:coverage-owned": "vp run quality:coverage-owned:steps",
    "quality:fix": "vp run quality:fix:steps",
    "verify": "vp run verify:steps",
    "verify:full": "vp run verify:full:steps",
    "test": "vp test run",
    "test:policy": "vp test run --config tooling/vitest.node.config.ts --project policy-node",
    "test:ci": "vp run test:ci:steps",
    "test:watch": "vp test watch",
    "test:cov": "vp test run --coverage",
    "test:cov:after-policy": "vp test run --coverage --config tooling/vitest.after-policy.config.ts",
    "test:e2e": "playwright test --config test/e2e/playwright.config.ts",
    "test:e2e:extension": "playwright test --config test/e2e/playwright.extension.config.ts",
    "test:e2e:extension:firefox": "vp test run --config tooling/vitest.node.config.ts --project firefox-installed",
    "test:e2e:native": "vp test run --config tooling/vitest.node.config.ts --project windows-native",
    "test:e2e:all": "vp run test:e2e:all:steps",
    "check:e2e": "tsc -p tsconfig.e2e.json --noEmit",
    "test:e2e:headed": "playwright test --config test/e2e/playwright.config.ts --headed",
    "check:tooling": "tsc -p tsconfig.tooling.json --noEmit"
  },
  "dependencies": {
    "@piesp/browser-core": "file:packages/core",
    "solid-js": "^1.9.17"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/selenium-webdriver": "4.35.7",
    "@vitest/coverage-v8": "catalog:",
    "jsdom": "30.1.3",
    "selenium-webdriver": "4.51.0",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plugin-solid": "^2.11.14",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1",
    "pnpm": ">=12.14.0"
  },
  "packageManager": "pnpm@12.15.0"
}
