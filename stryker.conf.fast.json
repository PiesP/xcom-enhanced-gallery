{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker/master/packages/core/schema/stryker-schema.json",
  "mutate": [
    "src/shared/services/download/single-download.ts",
    "src/shared/services/download/zip-download.ts",
    "src/shared/services/media/twitter-api-client.ts",
    "src/shared/utils/media/media-dimensions.ts",
    "src/shared/utils/media/media-url-utils.ts",
    "src/shared/utils/object/path.ts",
    "src/shared/utils/performance/observer-pool.ts",
    "src/shared/utils/performance/preload.ts",
    "src/shared/utils/performance/scheduler-yield.ts",
    "src/shared/utils/text/formatting.ts",
    "src/shared/utils/url/history-navigation.ts",
    "src/shared/utils/url/host.ts",
    "src/shared/utils/url/safety.ts",
    "src/shared/utils/url/url-safety.ts",
    "src/shared/utils/url/validator.ts"
  ],
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts",
    "related": false
  },
  "reporters": ["progress", "clear-text", "json", "html"],
  "coverageAnalysis": "perTest",
  "ignoreStatic": true,
  "thresholds": {
    "high": 80,
    "low": 75,
    "break": 70
  },
  "inPlace": true,
  "concurrency": 4,
  "timeoutMS": 120000,
  "plugins": ["@stryker-mutator/vitest-runner"],
  "mutator": {
    "excludedMutations": [
      "StringLiteral",
      "ArrayDeclaration",
      "ObjectLiteral",
      "ArrowFunction",
      "BlockStatement",
      "Regex",
      "UnaryOperator",
      "UpdateOperator",
      "OptionalChaining",
      "AssignmentOperator",
      "PrefixDecrementOperator",
      "PrefixIncrementOperator",
      "PostfixDecrementOperator",
      "PostfixIncrementOperator",
      "MethodExpression",
      "NonNullAssertion",
      "CheckedStatement",
      "SwitchCase",
      "WhileStatement",
      "ForStatement"
    ]
  }
}
