{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker/master/packages/core/schema/stryker-schema.json",
  "mutate": [
    "src/shared/utils/**/*.ts",
    "src/shared/async/**/*.ts",
    "src/shared/core/**/*.ts",
    "src/features/gallery/hooks/use-gallery-download.ts",
    "src/shared/services/download/**/*.ts",
    "src/shared/services/media/twitter-api-client.ts",
    "src/shared/services/media/media-factory.ts",
    "src/shared/services/media-extraction/determine-clicked-index.ts",
    "src/shared/services/media-extraction/media-extraction-service.ts",
    "src/shared/services/media-extraction/extractors/twitter-api-extractor.ts",
    "!src/**/*.d.ts",
    "!src/types/**",
    "!src/platform/**",
    "!src/**/types.ts"
  ],
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts",
    "related": false
  },
  "reporters": ["progress", "clear-text", "json", "html"],
  "coverageAnalysis": "all",
  "thresholds": {
    "high": 50,
    "low": 40,
    "break": 30
  },
  "inPlace": true,
  "concurrency": 2,
  "timeoutMS": 120000,
  "plugins": ["@stryker-mutator/vitest-runner"],
  "mutator": {
    "excludedMutations": [
      "StringLiteral",
      "ArrayDeclaration",
      "ObjectLiteral",
      "ArrowFunction",
      "BlockStatement",
      "Regex",
      "UnaryOperator",
      "UpdateOperator",
      "OptionalChaining",
      "AssignmentOperator",
      "PrefixDecrementOperator",
      "PrefixIncrementOperator",
      "PostfixDecrementOperator",
      "PostfixIncrementOperator",
      "MethodExpression",
      "NonNullAssertion",
      "CheckedStatement",
      "SwitchCase",
      "WhileStatement",
      "ForStatement"
    ]
  }
}
