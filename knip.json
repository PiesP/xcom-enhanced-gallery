{
  "$schema": "./node_modules/knip/schema.json",
  "entry": [
    "src/main.ts!",
    "src/extension/background.ts!",
    "src/extension/content.ts!",
    "scripts/check/{bootstrap,extension-build}.ts",
    "scripts/ci/{check-pinned-tools,classify-changes,pinned-tools,update-browser-core}.ts",
    "scripts/ci/*.test.ts",
    "scripts/release/{package-extension,prepare,verify-publication,verify-source,version}.ts",
    "scripts/release/*.test.ts",
    "test/e2e/specs/*.spec.ts",
    "vite*.ts",
    "tooling/vitest.after-policy.config.ts",
    "validation/windows/{install-profile,profile}.mjs"
  ],
  "project": [
    "src/**/*.ts!",
    "src/**/*.tsx!",
    "scripts/**/*.ts",
    "tooling/**/*.ts",
    "test/**/*.ts",
    "test/**/*.tsx",
    "test/**/*.mjs",
    "validation/windows/**/*.mjs",
    ".github/actions/**/*.mjs",
    "vite*.ts"
  ],
  "ignoreBinaries": ["openssl"],
  "ignoreExportsUsedInFile": true
}
