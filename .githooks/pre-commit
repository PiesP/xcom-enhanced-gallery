#!/usr/bin/env bash
set -euo pipefail

branch="$(git symbolic-ref --quiet --short HEAD || true)"

is_default_branch() {
  [[ "$1" == "master" || "$1" == "main" ]]
}

if [[ -z "$branch" ]]; then
  echo "Commits from a detached HEAD are blocked. Create a work branch first." >&2
  exit 1
fi

if is_default_branch "$branch"; then
  echo "Commits on '$branch' are blocked. Create a work branch and use a pull request." >&2
  exit 1
fi
