#!/usr/bin/env bash
set -euo pipefail

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  case "$remote_ref" in
    refs/heads/master|refs/heads/main)
      echo "Direct pushes to the default branch are blocked. Push a work branch and use a pull request." >&2
      exit 1
      ;;
    *) continue ;;
  esac
done
