{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "incremental": true,
    "stableTypeOrdering": true,
    "tsBuildInfoFile": ".vscode/.tsbuildinfo-tooling"
  },
  "include": ["tooling/**/*.ts", "vite*.config.ts", "vitest.config.ts"]
}
