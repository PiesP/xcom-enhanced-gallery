{
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "master"
  },
  "files": {
    "includes": [
      "**/*.css",
      "**/*.html",
      "**/*.ts",
      "**/*.tsx",
      "**/*.js",
      "**/*.mjs",
      "!!**/node_modules",
      "!!packages/core",
      "!!test/fixtures/authenticated-x-layouts/*.html"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "rules": {
      "preset": "none",
      "correctness": {
        "noUnknownMediaFeatureName": "error",
        "noUnknownPseudoElement": "error",
        "noSolidDestructuredProps": "error"
      },
      "style": {
        "noUnusedTemplateLiteral": "error"
      },
      "suspicious": {
        "noAssignInExpressions": "error",
        "noImplicitAnyLet": "error",
        "noConfusingVoidType": "warn"
      },
      "complexity": {
        "noUselessSwitchCase": "error"
      },
      "performance": {
        "noAccumulatingSpread": "error",
        "useSolidForComponent": "warn"
      },
      "a11y": {
        "noStaticElementInteractions": "error",
        "useKeyWithClickEvents": "error",
        "useMediaCaption": "error",
        "noSvgWithoutTitle": "error",
        "useAriaPropsSupportedByRole": "error",
        "useSemanticElements": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["test/e2e/fixtures/installed*-page.html"],
      "linter": {
        "rules": {
          "a11y": {
            "noNoninteractiveTabindex": "off",
            "useSemanticElements": "off",
            "useFocusableInteractive": "off",
            "noRedundantAlt": "off",
            "useAnchorContent": "off"
          }
        }
      }
    }
  ]
}
